vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 105
  }
}

# the arrows are really important, make them bold in different color
(** -> **)[*].style: {
  font-color: "#700"
  bold: true
  font-size: 24
}

**: {
  &leaf: false
  style.font-size: 36
}
**: {
  &leaf: true
  style.font-size: 24
}

classes: {
  waypoint: {
    shape: image
    style: {
      font-color: "#700"
      bold: true
    }
  }
}

computer: {
  direction: right
  top: 0
  left: 0
  icon: https://icons.d2lang.com/tech%2Flaptop.svg
  label: Your Computer
  icon.near: outside-top-left
  label.near: outside-top-center
  repo: {
    label: Local Git repository
    shape: stored_data
    icon: https://icons.d2lang.com/dev%2Fgit.svg
  }
  mysite: {
    label: ~/mysite\nEdited with Vim
    shape: package
    icon: https://icons.d2lang.com/dev%2Fvim.svg
  }
  html: {
    label: |md
      ## HTML output
      `http://127.0.0.1:1111`
    |
    shape: page
    # icon: https://icons.d2lang.com/tech%2Fbrowser-2.svg
  }
  zola: {
    class: waypoint
    label: zola serve
    icon: logo-zola.svg
    width: 80
    height: 30
  }
  mysite -> zola -> html
  prek: {
    class: waypoint
    label: git commit\nguarded by prek
    icon: logo-prek.webp
    width: 160
    height: 60
  }
  mysite -> prek -> repo
}

github: {
  icon: https://icons.d2lang.com/social%2F039-github.svg
  label: GitHub\n(vEnhance/ssg.evanchen.cc)
  icon.near: outside-top-left
  label.near: outside-top-right
  shape: cylinder
  repo: {
    label: Remote Git repository
    shape: stored_data
    icon: https://icons.d2lang.com/dev%2Fgit.svg
  }
  html: {
    label: |md
      ## HTML output
      `https://venhance.github.io`
    |
    shape: page
  }
  zola: {
    class: waypoint
    label: zola build\nvia GitHub Pages
    icon: logo-zola.svg
    width: 80
    height: 30
  }
  repo -> zola -> html
}

computer.repo -> github.repo: git push
github.repo -> computer.repo: git pull

hostname: {
  shape: cloud
  label: https://ssg.evanchen.cc
}
cloudflare: {
  class: waypoint
  label: CloudFlare DNS
  icon: logo-cloudflare.svg
  width: 120
  height: 45
}
hostname -> cloudflare -> github.html
